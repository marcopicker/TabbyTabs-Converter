<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BardicTabConverter.App.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Style TargetType="{x:Type controls:SubSettingItemsControl}">
        <Setter Property="AlternationCount" Value="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Focusable" Value="False"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SubSettingItemsControl}">
                    <StackPanel Orientation="Vertical"
                                Focusable="False">
                        <Border Padding="16,10,16,10"
                                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Focusable="False">
                            <StackPanel Orientation="Vertical"
                                        Focusable="False">

                                <ui:TextBlock x:Name="HeaderTextBlock"
                                              Text="{TemplateBinding HeaderText}"
                                              FontTypography="BodyStrong"
                                              Focusable="False" />

                                <ui:TextBlock x:Name="DescriptionText"
                                              Text="{TemplateBinding DescriptionText}"
                                              FontTypography="Caption"
                                              VerticalAlignment="Center"
                                              TextWrapping="Wrap" />

                                <Rectangle x:Name="HeaderSeparator"
                                           HorizontalAlignment="Stretch"
                                           Margin="-16, 8"
                                           Height="1"
                                           Fill="{DynamicResource WindowBackground}"
                                           Focusable="False" />

                                <ContentPresenter x:Name="InternalHeaderContent"
                                                  Content="{TemplateBinding InternalHeaderContent}"
                                                  ContentTemplate="{TemplateBinding InternalHeaderTemplate}" />

                                <ItemsPresenter Focusable="False" />

                                <ContentPresenter x:Name="EmptyContentPresenter"
                                                  Content="{TemplateBinding EmptyContent}"
                                                  ContentTemplate="{TemplateBinding EmptyContentTemplate}"
                                                  HorizontalAlignment="Stretch"
                                                  Focusable="False" />

                                <Rectangle x:Name="Separator"
                                           Visibility="{TemplateBinding AddButtonVisibility}"
                                           HorizontalAlignment="Stretch"
                                           Margin="-16, 8"
                                           Height="1"
                                           Fill="{DynamicResource WindowBackground}"
                                           Focusable="False" />

                                <ui:Button Content="Add"
                                           HorizontalAlignment="Right"
                                           Command="{TemplateBinding AddCommand}"
                                           Visibility="{TemplateBinding AddButtonVisibility}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HeaderText" Value="{x:Null}">
                            <Setter TargetName="HeaderTextBlock" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderSeparator" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="DescriptionText" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="EmptyContentPresenter" Property="Visibility" Value="Collapsed" />
                            <!-- <Setter TargetName="InternalHeaderContent" Property="Visibility" Value="Collapsed" /> -->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentControl">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContentControl">
                                <StackPanel Focusable="False">
                                    <Rectangle x:Name="Separator"
                                               HorizontalAlignment="Stretch"
                                               Margin="-16, 8"
                                               Height="1"
                                               Fill="{DynamicResource WindowBackground}"
                                               Focusable="False" />
                                    <ContentPresenter />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="EmptyContent" Value="MEOW" />
        <Setter Property="EmptyContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Vertical"
                                DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:SubSettingItemsControl}}}">
                        <ui:SymbolIcon Symbol="MailInbox24"
                                       FontSize="24" />
                        <ui:TextBlock FontTypography="Body"
                                      HorizontalAlignment="Center"
                                      TextAlignment="Center"
                                      TextWrapping="Wrap"
                                      Text="This list is empty. Press the 'Add' button on the bottom to add an element!" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>