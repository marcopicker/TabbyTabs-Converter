<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TabbyTabs.Converter.App.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style TargetType="{x:Type controls:SubSettingContentControl}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SubSettingContentControl}">
                    <Border x:Name="MainBorder"
                            Focusable="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch">
                                <ui:TextBlock x:Name="HeaderText"
                                              Text="{TemplateBinding HeaderText}"
                                              FontTypography="BodyStrong"
                                              VerticalAlignment="Center"
                                              TextWrapping="Wrap" />
                                <ui:TextBlock x:Name="DescriptionText"
                                              Text="{TemplateBinding DescriptionText}"
                                              FontTypography="Caption"
                                              VerticalAlignment="Center"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Stretch"
                                        Orientation="Horizontal"
                                        Margin="8,0,0,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HeaderText" Property="Opacity" Value="0.5" />
                            <Setter TargetName="DescriptionText" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="DescriptionText" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowBorder" Value="True">
                            <Setter TargetName="MainBorder" Property="Padding" Value="16,10,16,10" />
                            <Setter TargetName="MainBorder" Property="Background" Value="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
                            <Setter TargetName="MainBorder" Property="BorderThickness" Value="1" />
                            <Setter TargetName="MainBorder" Property="CornerRadius" Value="8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>