<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TabbyTabs.Converter.App.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:converters="clr-namespace:TabbyTabs.Converter.App.Converters">
    <converters:BooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"
                                             True="Collapsed"
                                             False="Visible" />
    <Style TargetType="{x:Type controls:ValidityIcon}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ValidityIcon}">
                    <ui:SymbolIcon x:Name="Icon"
                                   Symbol="ErrorCircle12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="8,0,0,0"
                                   ToolTip="{Binding Path=ValidityMessage, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   ToolTipService.InitialShowDelay="0"
                                   Focusable="False">
                        <ui:SymbolIcon.Foreground>
                            <SolidColorBrush Color="{DynamicResource PaletteRedColor}" />
                        </ui:SymbolIcon.Foreground>
                    </ui:SymbolIcon>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ValidityMessage" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="ToolTipService.ShowDuration" Value="0" />
                        </Trigger>
                        <Trigger Property="ValidityType" Value="Valid">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ValidityType" Value="Warning">
                            <Setter TargetName="Icon" Property="Symbol" Value="Warning12" />
                            <Setter TargetName="Icon" Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource PaletteYellowColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>