<UserControl x:Class="TabbyTabs.Converter.App.Views.Settings.RehearsalMarkRenderingSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:TabbyTabs.Converter.App.Controls"
             xmlns:settings="clr-namespace:TabbyTabs.Converter.App.ViewModels.Settings"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300" x:ClassModifier="internal"
             d:DataContext="{d:DesignInstance settings:RehearsalMarkRenderingSettingsViewModel}">
    <StackPanel Margin="0,0,8,0">
        <controls:SubSettingItemsControl AddButtonVisibility="Collapsed"
                                         Margin="0,0,0,16">
            <controls:SubSettingItemsControl.Items>
                <controls:SubSettingContentControl HeaderText="Show Rehearsal Marks"
                                                   ShowBorder="False">
                    <ui:ToggleSwitch IsChecked="{Binding DrawRehearsalMarks.Value}" />
                </controls:SubSettingContentControl>

                <controls:SubSettingContentControl HeaderText="Format"
                                                   DescriptionText="Use '{0}' as a placeholder for the thext."
                                                   IsEnabled="{Binding DrawRehearsalMarks.Value}"
                                                   ShowBorder="False">
                    <ui:TextBox Text="{Binding Format.Value, UpdateSourceTrigger=PropertyChanged}"
                                ClearButtonEnabled="False"
                                HorizontalAlignment="Stretch"
                                MinWidth="90"/>
                </controls:SubSettingContentControl>

                <controls:SubSettingContentControl HeaderText="Lines Before"
                                                   IsEnabled="{Binding DrawRehearsalMarks.Value}"
                                                   ShowBorder="False">
                    <ui:NumberBox Value="{Binding LinesBeforeRehearsalMark.Value, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="0"
                                  ClearButtonEnabled="False" />
                </controls:SubSettingContentControl>

                <controls:SubSettingContentControl HeaderText="Lines After"
                                                   IsEnabled="{Binding DrawRehearsalMarks.Value}"
                                                   ShowBorder="False">
                    <ui:NumberBox Value="{Binding LinesAfterRehearsalMark.Value, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="0"
                                  ClearButtonEnabled="False" />
                </controls:SubSettingContentControl>
            </controls:SubSettingItemsControl.Items>
        </controls:SubSettingItemsControl>
    </StackPanel>
</UserControl>