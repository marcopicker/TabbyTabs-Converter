<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GW2MidiConverter.App.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style TargetType="{x:Type controls:SubSettingItemsControl}">
        <Setter Property="AlternationCount" Value="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Focusable" Value="False"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SubSettingItemsControl}">
                    <StackPanel Orientation="Vertical"
                                Focusable="False">
                        <ui:TextBlock x:Name="HeaderTextBlock"
                                      Text="{TemplateBinding HeaderText}"
                                      FontTypography="BodyStrong"
                                      Margin="0,0,0,8"
                                      Focusable="False" />
                        <Border Padding="16,10,16,10"
                                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Focusable="False">
                            <StackPanel Orientation="Vertical"
                                        Focusable="False">
                                <ContentPresenter Content="{TemplateBinding InternalHeaderContent}"
                                                  ContentTemplate="{TemplateBinding InternalHeaderTemplate}">
                                    <!-- <ContentPresenter.Style> -->
                                    <!--     <Style TargetType="ContentPresenter"> -->
                                    <!--         <Style.Triggers> -->
                                    <!--             <Trigger Property="Content" Value="{x:Null}"> -->
                                    <!--                 <Trigger.Setters> -->
                                    <!--                     <Setter Property="Visibility" Value="Collapsed" /> -->
                                    <!--                 </Trigger.Setters> -->
                                    <!--             </Trigger> -->
                                    <!--         </Style.Triggers> -->
                                    <!--     </Style> -->
                                    <!-- </ContentPresenter.Style> -->
                                </ContentPresenter>
                                <ItemsPresenter Focusable="False" />
                                <ContentPresenter Content="{TemplateBinding EmptyContent}"
                                                  ContentTemplate="{TemplateBinding EmptyContentTemplate}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Focusable="False">
                                    <ContentPresenter.Style>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentPresenter.Style>
                                </ContentPresenter>
                                <Rectangle x:Name="Separator"
                                           Visibility="{TemplateBinding AddButtonVisibility}"
                                           HorizontalAlignment="Stretch"
                                           Margin="-16, 8"
                                           Height="1"
                                           Fill="{DynamicResource WindowBackground}"
                                           Focusable="False" />
                                <ui:Button Content="Add"
                                           HorizontalAlignment="Right"
                                           Command="{TemplateBinding AddCommand}"
                                           Visibility="{TemplateBinding AddButtonVisibility}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HeaderText" Value="{x:Null}">
                            <Setter TargetName="HeaderTextBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentControl">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContentControl">
                                <StackPanel Focusable="False">
                                    <Rectangle x:Name="Separator"
                                               HorizontalAlignment="Stretch"
                                               Margin="-16, 8"
                                               Height="1"
                                               Fill="{DynamicResource WindowBackground}"
                                               Focusable="False" />
                                    <ContentPresenter />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>