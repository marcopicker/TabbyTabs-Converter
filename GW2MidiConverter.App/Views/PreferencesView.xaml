<UserControl x:Class="GW2MidiConverter.App.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:GW2MidiConverter.App.Controls"
             xmlns:viewModels="clr-namespace:GW2MidiConverter.App.ViewModels"
             xmlns:converters="clr-namespace:GW2MidiConverter.App.Converters"
             xmlns:resources="clr-namespace:GW2MidiConverter.App.Resources"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance viewModels:PreferencesViewModel}"
             MinWidth="500"
             MaxWidth="1000"
             MaxHeight="850"
             Focusable="False">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"
                                                 True="Visible"
                                                 False="Collapsed" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"
                                                 True="Collapsed"
                                                 False="Visible" />
        <Style x:Key="HyperLinkStyle"
               TargetType="{x:Type Hyperlink}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource HyperlinkButtonForeground}" />
            <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource HyperlinkButtonForegroundPointerOver}" />
                    <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" 
                   x:Name="HeaderPanel"
                   LastChildFill="True"
                   Margin="0,0,0,16">
            <ui:Button DockPanel.Dock="Right"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Right"
                       Margin="16,0,0,0"
                       Style="{DynamicResource BasePaneButtonStyle}"
                       Click="CloseButton_Clicked" />
            <ui:TextBlock DockPanel.Dock="Left"
                          Text="Preferences"
                          FontTypography="Title" />
        </DockPanel>
        <ScrollViewer Grid.Row="1" 
                      x:Name="ContentScroller"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.IsSharedSizeScope="False">
                <controls:SubSettingContentControl HeaderText="New version available"
                                                   DescriptionText="{Binding NewVersion, StringFormat={}Version {0} is available!}"
                                                   Margin="0,0,0,8"
                                                   Visibility="{Binding IsNewVersionAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Button Appearance="Primary"
                               Content="Download new version"
                               Command="{Binding GetUpdateCommand}" />
                </controls:SubSettingContentControl>

                <controls:SubSettingContentControl HeaderText="Version"
                                                   DescriptionText="{Binding CurrentVersion, StringFormat={}Current version: {0}}"
                                                   Margin="0,0,0,8"
                                                   Visibility="{Binding IsNewVersionAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ui:Button Appearance="Secondary"
                               Content="Check for updates"
                               Command="{Binding CheckForUpdateCommand}" />
                </controls:SubSettingContentControl>

                <controls:SubSettingContentControl HeaderText="Automatic update checks"
                                                   DescriptionText="Check for an update every time you start this program."
                                                   IsEnabled="False">
                    <ui:ToggleSwitch OnContent="Yes"
                                     OffContent="No"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding AutoCheckForUpdates}" />
                </controls:SubSettingContentControl>

                <Rectangle HorizontalAlignment="Stretch"
                           Margin="0,16"
                           Height="1"
                           Fill="{DynamicResource ContentDialogBorderBrush}"
                           Focusable="False" />

                <ui:TextBlock Text="About"
                              FontTypography="Subtitle"
                              Margin="0,0,0,8" />
                <ui:TextBlock>
                    <Run Text="{x:Static resources:ApplicationResources.ApplicationName}" />
                    <Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                </ui:TextBlock>
                <ui:TextBlock Margin="0,0,0,8">
                    <Run Text="Copyright © 2025" />
                    <Hyperlink NavigateUri="https://www.google.com"
                               RequestNavigate="Hyperlink_OnRequestNavigate"
                               Style="{StaticResource HyperLinkStyle}">
                        <Run Text="Marco Picker" />
                    </Hyperlink>
                </ui:TextBlock>
                <ui:TextBlock Text="Powered by:" />
                <ItemsControl ItemsSource="{Binding LicenseAttributions}"
                              Margin="8,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:LicenseAttribution}">
                            <ui:TextBlock>
                                <Hyperlink NavigateUri="{Binding Url}"
                                           RequestNavigate="Hyperlink_OnRequestNavigate"
                                           Style="{StaticResource HyperLinkStyle}">
                                    <Run Text="{Binding SoftwareName}" />
                                </Hyperlink>
                                <Run Text="{Binding Version}"
                                     Foreground="{ui:ThemeResource TextFillColorDisabledBrush}" />
                                <Hyperlink NavigateUri="{Binding LicenseUrl}"
                                           RequestNavigate="Hyperlink_OnRequestNavigate"
                                           Style="{StaticResource HyperLinkStyle}">
                                    <Run Text="{Binding LicenseName}" />
                                </Hyperlink>
                            </ui:TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>