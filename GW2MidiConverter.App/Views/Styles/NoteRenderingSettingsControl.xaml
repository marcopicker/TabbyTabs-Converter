<UserControl x:Class="GW2MidiConverter.App.Views.Styles.NoteRenderingSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:GW2MidiConverter.App.Converters"
             xmlns:noteRenderingSettings="clr-namespace:GW2MidiConverter.App.ViewModels.Settings.NoteRenderingSettings"
             xmlns:controls="clr-namespace:GW2MidiConverter.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance noteRenderingSettings:NoteRendererSettingsViewModel}"
             Focusable="False">
    <UserControl.Resources>
        <converters:GuildWarsKeyToStringConverter x:Key="KeyToStringConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"
                                                 True="Hidden"
                                                 False="Visible" />
    </UserControl.Resources>
    <StackPanel Margin="0,0,8,0">
        <controls:SubSettingItemsControl ItemsSource="{Binding KeyNamesSubSetting.Items}"
                                       Grid.IsSharedSizeScope="True"
                                       HorizontalAlignment="Stretch"
                                       AddButtonVisibility="Collapsed"
                                       HeaderText="Note Names"
                                       Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical"
                                Focusable="False">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="{Binding Key, Converter={StaticResource KeyToStringConverter}}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" 
                                          Focusable="False"/>
                            <ui:TextBox Grid.Column="2"
                                        Text="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        MaxLength="4" />
                            <ui:SymbolIcon Grid.Column="3"
                                           Symbol="ErrorCircle12"
                                           Visibility="{Binding IsValid, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                           ToolTip="{Binding InvalidMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                           Focusable="False">
                                <ui:SymbolIcon.Foreground>
                                    <SolidColorBrush Color="{DynamicResource PaletteRedColor}" />
                                </ui:SymbolIcon.Foreground>
                            </ui:SymbolIcon>
                        </Grid>
                    </StackPanel>
                    <!-- <DataTemplate.Triggers> -->
                    <!--     <Trigger Property="ItemsControl.AlternationIndex" Value="0"> -->
                    <!--         <Setter TargetName="Separator" Property="Visibility" Value="Collapsed"/> -->
                    <!--     </Trigger> -->
                    <!-- </DataTemplate.Triggers> -->
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </controls:SubSettingItemsControl>

        <controls:SubSettingItemsControl ItemsSource="{Binding BracketPairSubSetting.Items}"
                                       AddCommand="{Binding BracketPairSubSetting.AddCommand}"
                                       Grid.IsSharedSizeScope="True"
                                       HeaderText="Octaves Brackets"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,16">
            <controls:SubSettingItemsControl.EmptyContentTemplate>
                <DataTemplate>
                    <ui:TextBlock FontTypography="Caption"
                                  Text="Add stuff, nya :3" />
                </DataTemplate>
            </controls:SubSettingItemsControl.EmptyContentTemplate>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:NumberBox Grid.Column="0"
                                      Value="{Binding Octave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      MaxLength="2"
                                      MaxDecimalPlaces="0" />
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding OpeningBracket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    MaxLength="1" />
                        <ui:TextBox Grid.Column="2"
                                    Text="{Binding ClosingBracket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    MaxLength="1" />
                        <ui:Button Grid.Column="3" Content="X"
                                   Command="{Binding Path=DataContext.BracketPairSubSetting.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:SubSettingItemsControl}}}"
                                   CommandParameter="{Binding}" />
                        <ui:SymbolIcon Grid.Column="4"
                                       Symbol="ErrorCircle12"
                                       Visibility="{Binding IsValid, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                       ToolTip="{Binding InvalidMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                            <ui:SymbolIcon.Foreground>
                                <SolidColorBrush Color="{DynamicResource PaletteRedColor}" />
                            </ui:SymbolIcon.Foreground>
                        </ui:SymbolIcon>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </controls:SubSettingItemsControl>

        <controls:SubSettingItemsControl ItemsSource="{Binding RestSymbolsPerBeatSubSetting.Items}"
                                       AddCommand="{Binding RestSymbolsPerBeatSubSetting.AddCommand}"
                                       Grid.IsSharedSizeScope="True"
                                       HeaderText="Rest Symbols"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:NumberBox Grid.Column="0"
                                      Value="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      MaxDecimalPlaces="3" />
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding Symbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    MaxLength="1" />
                        <ui:Button Grid.Column="2" Content="X"
                                   Command="{Binding Path=DataContext.RestSymbolsPerBeatSubSetting.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:SubSettingItemsControl}}}"
                                   CommandParameter="{Binding}" />
                        <ui:SymbolIcon Grid.Column="3"
                                       Symbol="ErrorCircle12"
                                       Visibility="{Binding IsValid, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                       ToolTip="{Binding InvalidMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                            <ui:SymbolIcon.Foreground>
                                <SolidColorBrush Color="{DynamicResource PaletteRedColor}" />
                            </ui:SymbolIcon.Foreground>
                        </ui:SymbolIcon>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </controls:SubSettingItemsControl>

        <controls:SubSettingItemsControl ItemsSource="{Binding TrailingSpacesPerBeatSubSetting.Items}"
                                       AddCommand="{Binding TrailingSpacesPerBeatSubSetting.AddCommand}"
                                       Grid.IsSharedSizeScope="True"
                                       HeaderText="Trailing Spaces"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:NumberBox Grid.Column="0"
                                      Value="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      MaxDecimalPlaces="3" />
                        <ui:NumberBox Grid.Column="1"
                                      Value="{Binding SpaceCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      MaxDecimalPlaces="0"
                                      Minimum="0" />
                        <ui:Button Grid.Column="2" Content="X"
                                   Command="{Binding Path=DataContext.TrailingSpacesPerBeatSubSetting.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:SubSettingItemsControl}}}"
                                   CommandParameter="{Binding}" />
                        <ui:SymbolIcon Grid.Column="3"
                                       Symbol="ErrorCircle12"
                                       Visibility="{Binding IsValid, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                       ToolTip="{Binding InvalidMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                            <ui:SymbolIcon.Foreground>
                                <SolidColorBrush Color="{DynamicResource PaletteRedColor}" />
                            </ui:SymbolIcon.Foreground>
                        </ui:SymbolIcon>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </controls:SubSettingItemsControl>
    </StackPanel>
</UserControl>