<UserControl x:Class="GW2MidiConverter.App.Views.Styles.NoteRenderingSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:GW2MidiConverter.App.Converters"
             xmlns:settings="clr-namespace:GW2MidiConverter.App.ViewModels.Settings"
             xmlns:noteRenderingSettings="clr-namespace:GW2MidiConverter.App.ViewModels.Settings.NoteRenderingSettings"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance noteRenderingSettings:NoteRendererSettingsViewModel}">
    <UserControl.Resources>
        <converters:GuildWarsKeyToStringConverter x:Key="KeyToStringConverter" />
    </UserControl.Resources>
    <StackPanel>
        <ui:TextBlock Text="Note Names"
                      FontTypography="BodyStrong"
                      Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding KeyNamesSubSetting.Items}"
                      Grid.IsSharedSizeScope="True"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      Text="{Binding Key, Converter={StaticResource KeyToStringConverter}, StringFormat={}{0} symbol:}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                        <ui:TextBox Grid.Column="2"
                                    Text="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    MaxLength="4" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:TextBlock Text="Bracket Pairs"
                      FontTypography="BodyStrong"
                      Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding BracketPairSubSetting.Items}"
                      Grid.IsSharedSizeScope="True"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:NumberBox Grid.Column="0"
                                      Value="{Binding Octave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      MaxLength="2"
                                      MaxDecimalPlaces="0" />
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding OpeningBracket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    MaxLength="1" />
                        <ui:TextBox Grid.Column="2"
                                    Text="{Binding ClosingBracket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    MaxLength="1" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:TextBlock Text="Rest Symbols Per Beat"
                      FontTypography="BodyStrong"
                      Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding RestSymbolsPerBeatSubSetting.Items}"
                      Grid.IsSharedSizeScope="True"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:NumberBox Grid.Column="0"
                                      Value="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      MaxDecimalPlaces="3" />
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding Symbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    MaxLength="1" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <ui:TextBlock Text="Trailing Spaces Pet Beat"
                      FontTypography="BodyStrong"
                      Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding TrailingSpacesPerBeatSubSetting.Items}"
                      Grid.IsSharedSizeScope="True"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:NumberBox Grid.Column="0"
                                      Value="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      MaxDecimalPlaces="3" />
                        <ui:NumberBox Grid.Column="1"
                                      Value="{Binding SpaceCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      MaxDecimalPlaces="0"
                                      Minimum="0" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>