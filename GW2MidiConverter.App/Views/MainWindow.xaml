<ui:FluentWindow x:Class="GW2MidiConverter.App.Views.MainWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:GW2MidiConverter.App.Views"
                 xmlns:viewModels="clr-namespace:GW2MidiConverter.App.ViewModels"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
                 Title="{Binding ApplicationTitle}"
                 Height="800"
                 Width="1300"
                 MinWidth="800"
                 MinHeight="450"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Default"
                 WindowStartupLocation="CenterScreen"
                 PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type viewModels:FileLoaderViewModel}">
            <controls:FileLoaderControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TabRendererViewModel}">
            <controls:TabRenderingControl />
        </DataTemplate>
    </ui:FluentWindow.Resources>
    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <ContentControl Content="{Binding CurrentViewModel}"
                        Focusable="False" />
        <ui:TitleBar Title="{Binding ApplicationTitle}"
                     Icon="{ui:SymbolIcon MusicNote120}" />
        <ContentPresenter x:Name="RootContentDialog" />
        <Border x:Name="PreferencesBackdrop"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#3F000000"
                IsHitTestVisible="True"
                Focusable="False"
                Visibility="Collapsed"
                MouseDown="PreferencesBackdrop_OnMouseDown">
            <Border Focusable="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PopupCornerRadius}"
                    BorderBrush="{DynamicResource ContentDialogBorderBrush}"
                    Background="{DynamicResource ContentDialogBackground}"
                    Margin="64">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      Direction="0"
                                      Opacity="0.4"
                                      ShadowDepth="0"
                                      Color="#202020" />
                </Border.Effect>
                <controls:PreferencesView x:Name="PreferencesView"
                                          CloseRequested="PreferencesView_OnCloseRequested"/>
            </Border>
        </Border>
        <ui:Button x:Name="PreferencesButton"
                   HorizontalContentAlignment="Stretch"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="8"
                   Width="32"
                   Height="32"
                   ToolTip="Settings"
                   Padding="0"
                   Click="PreferencesButton_OnClick">
            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <ui:SymbolIcon Grid.Column="0"
                               HorizontalAlignment="Center"
                               Symbol="Settings24" />
            </Grid>
        </ui:Button>
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
    </Grid>
</ui:FluentWindow>