<UserControl x:Class="GW2MidiConverter.App.Views.Settings.TimeSignatureRenderingSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:GW2MidiConverter.App.Controls"
             xmlns:settings="clr-namespace:GW2MidiConverter.App.ViewModels.Settings"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300" x:ClassModifier="internal"
             d:DataContext="{d:DesignInstance settings:TimeSignatureRenderingSettingsViewModel}">
    <StackPanel Margin="0,0,8,0">
        <controls:SubSettingContentControl HeaderText="Visibility"
                                           DescriptionText="When to position the time signatures."
                                           Margin="0,0,0,16">
            <ComboBox ItemsSource="{Binding TimeSignatureVisibility.EnumTypeValues}"
                      SelectedItem="{Binding TimeSignatureVisibility.Value}" />
        </controls:SubSettingContentControl>
        
        <controls:SubSettingContentControl HeaderText="Position"
                                           DescriptionText="Where to position the time signatures.">
            <ComboBox ItemsSource="{Binding TimeSignaturePositioning.EnumTypeValues}"
                      SelectedItem="{Binding TimeSignaturePositioning.Value}" />
        </controls:SubSettingContentControl>
    </StackPanel>
</UserControl>