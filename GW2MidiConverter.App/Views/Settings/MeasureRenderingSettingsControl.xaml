<UserControl x:Class="GW2MidiConverter.App.Views.Settings.MeasureRenderingSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:GW2MidiConverter.App.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:settings="clr-namespace:GW2MidiConverter.App.ViewModels.Settings"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300" x:ClassModifier="internal"
             d:DataContext="{d:DesignInstance settings:MeasureRenderingSettingsViewModel}">
    <StackPanel Margin="0,0,8,0">
        <controls:SubSettingContentControl Margin="0,0,0,16"
                                           HeaderText="Show Measure Numbers">
            <ui:ToggleSwitch IsChecked="{Binding ShowMeasureNumbers.Value}" />
        </controls:SubSettingContentControl>

        <controls:SubSettingItemsControl AddButtonVisibility="Collapsed"
                                         Margin="0,0,0,16">
            <controls:SubSettingItemsControl.Items>
                <controls:SubSettingContentControl HeaderText="Show Measure Delimiters"
                                                   ShowBorder="False">
                    <ui:ToggleSwitch IsChecked="{Binding DrawMeasureDelimiters.Value}" />
                </controls:SubSettingContentControl>

                <controls:SubSettingContentControl HeaderText="Measure Delimiter"
                                                   IsEnabled="{Binding DrawMeasureDelimiters.Value}"
                                                   ShowBorder="False">
                    <ui:TextBox Text="{Binding MeasureDelimiter.Value, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="1"
                                MinWidth="40"
                                TextAlignment="Center"
                                ClearButtonEnabled="False" />
                </controls:SubSettingContentControl>

                <controls:SubSettingContentControl HeaderText="Padding"
                                                   IsEnabled="{Binding DrawMeasureDelimiters.Value}"
                                                   ShowBorder="False">
                    <ui:NumberBox Value="{Binding MeasureDelimiterPadding.Value, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="0"
                                  ClearButtonEnabled="False" />
                </controls:SubSettingContentControl>
            </controls:SubSettingItemsControl.Items>
        </controls:SubSettingItemsControl>

        <controls:SubSettingContentControl HeaderText="Beat Spacing"
                                           DescriptionText="The number of spaces that are placed between each beat of a measure.">
            <ui:NumberBox Value="{Binding SpacesBetweenBeats.Value, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="1"
                          ClearButtonEnabled="False" />
        </controls:SubSettingContentControl>
    </StackPanel>
</UserControl>