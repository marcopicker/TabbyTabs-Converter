<UserControl x:Class="GW2MidiConverter.App.Views.Settings.TrackRenderingSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:GW2MidiConverter.App.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:settings="clr-namespace:GW2MidiConverter.App.ViewModels.Settings"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300" x:ClassModifier="internal"
             d:DataContext="{d:DesignInstance settings:TrackRenderingSettingsViewModel}">
    <StackPanel Margin="0,0,8,0">
        <controls:SubSettingItemsControl AddButtonVisibility="Collapsed"
                                         Margin="0,0,0,16">
            <controls:SubSettingItemsControl.Items>
                <controls:SubSettingContentControl HeaderText="Show Track Name"
                                                   ShowBorder="False">
                    <ui:ToggleSwitch IsChecked="{Binding ShowTrackName.Value}" />
                </controls:SubSettingContentControl>
                
                <controls:SubSettingContentControl HeaderText="Line Breaks After Track Name"
                                                   ShowBorder="False"
                                                   IsEnabled="{Binding ShowTrackName.Value}">
                    <ui:NumberBox Value="{Binding LineBreaksAfterTrackName.Value, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="0"
                                  ClearButtonEnabled="False"/>
                </controls:SubSettingContentControl>
            </controls:SubSettingItemsControl.Items>
        </controls:SubSettingItemsControl>

        <controls:SubSettingContentControl HeaderText="Line Breaks Between Tracks"
                                           Margin="0,0,0,16">
            <ui:NumberBox Value="{Binding LineBreaksBetweenTracks.Value, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="0"
                          ClearButtonEnabled="False"/>
        </controls:SubSettingContentControl>
        
        <controls:SubSettingContentControl HeaderText="Lines Until Line Break"
                                           DescriptionText="How many lines can be rendered until a line break."
                                           Margin="0,0,0,16">
            <ui:NumberBox Value="{Binding MaxMeasureCountBeforeLineBreak.Value, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="1"
                          ClearButtonEnabled="False"/>
        </controls:SubSettingContentControl>
        
        <controls:SubSettingItemsControl AddButtonVisibility="Collapsed"
                                         Margin="0,0,0,16">
            <controls:SubSettingItemsControl.Items>
                <controls:SubSettingContentControl HeaderText="Lines Before Time Signatures"
                                                   ShowBorder="False">
                    <ui:NumberBox Value="{Binding LinesBeforeTimeSignature.Value, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="0"
                                  ClearButtonEnabled="False"/>
                </controls:SubSettingContentControl>
                
                <controls:SubSettingContentControl HeaderText="Lines After Time Signatures"
                                                   ShowBorder="False">
                    <ui:NumberBox Value="{Binding LinesAfterTimeSignature.Value, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="0"
                                  ClearButtonEnabled="False"/>
                </controls:SubSettingContentControl>
            </controls:SubSettingItemsControl.Items>
        </controls:SubSettingItemsControl>
        
        <controls:SubSettingContentControl HeaderText="Measures Per Line">
            <ui:NumberBox Value="{Binding MeasuresPerLine.Value, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="1"
                          ClearButtonEnabled="False"/>
        </controls:SubSettingContentControl>
    </StackPanel>
</UserControl>